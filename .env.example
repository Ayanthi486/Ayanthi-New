# =============================================================================
# Hub Lanka Pvt Limited — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file. Secrets belong in the deployment platform's
# secret manager in staging/production, not in source control.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
# unique id correlating logs across a single request lifecycle is generated
# per-request; nothing to configure here.

# --- API -----------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
# Base path is fixed to /api/v1 in code (ARCHITECTURE §7), not configurable.

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Swagger UI toggle. ARCHITECTURE §7: enabled on staging, disabled/authenticated
# in production. Defaults to true in development.
SWAGGER_ENABLED=true

# --- Database (PostgreSQL 17 / Prisma 7) --------------------------------------
# Local development default matches docker-compose.yml. Host port is 5433,
# not the PostgreSQL default 5432, to avoid colliding with a PostgreSQL
# instance already installed natively on the developer machine.
#
# DATABASE_URL: privileged/migration connection — prisma.config.ts and the
# CLI (`prisma migrate ...`) only. Never used by the running application.
DATABASE_URL=postgresql://hublanka:hublanka_dev_password@localhost:5433/hublanka_dev?schema=public
# APP_DATABASE_URL: restricted runtime connection the app actually uses.
# This role has no UPDATE/DELETE on audit_log at the database grant level
# (ARCHITECTURE §10) — see apps/api/prisma/migrations/*_restrict_audit_log_grants.
APP_DATABASE_URL=postgresql://hublanka_app:hublanka_app_dev_password@localhost:5433/hublanka_dev?schema=public

# --- Web (Vite) ----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Auth foundation (values consumed starting Phase 1) -----------------------
# JWT access token: short-lived, held in memory on the client (never localStorage).
JWT_ACCESS_SECRET=change-me-in-local-env-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token: rotated, stored hashed server-side, delivered via httpOnly
# Secure SameSite=Strict cookie (ARCHITECTURE §8).
JWT_REFRESH_SECRET=change-me-in-local-env-min-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=hub_lanka_refresh_token

# Argon2id parameters (ARCHITECTURE §8). Tuned defaults; do not lower memory
# cost without a documented reason (DEVELOPMENT_RULES §10).
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Account lockout (ARCHITECTURE §8: "Account lockout after repeated
# failures"). Operational security parameters, not a PRD business rule.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# --- Logging (Pino) ------------------------------------------------------------
LOG_LEVEL=info
# Pretty-printed logs in development, structured JSON in staging/production.
LOG_PRETTY=true

# --- File storage (ARCHITECTURE §12, values consumed starting Phase 6) --------
# Local-disk StorageService adapter. An R2 adapter behind the same interface
# arrives once there is a real bucket/credentials to build against.
STORAGE_LOCAL_DIR=./storage-local
# Not company-stated (BR-56 receipt uploads) — an inferred, configurable default.
RECEIPT_MAX_SIZE_MB=10

# --- Background worker (ARCHITECTURE §15, values consumed starting Phase 7) ---
# Host port 6380 (docker-compose.yml), not Redis's default 6379 — avoids
# colliding with a locally installed Redis, matching DATABASE_URL's 5433.
REDIS_URL=redis://localhost:6380
# ARCHITECTURE §13: adapter selection lives in configuration, not code.
# ZebraZd420Adapter is currently a stub (no real cable/ZPL protocol yet).
PRINTER_ADAPTER=pdf
# ARCHITECTURE §11: 1-2 Chromium contexts, capped.
PDF_RENDER_CONCURRENCY=2
PDF_RENDER_TIMEOUT_MS=30000
