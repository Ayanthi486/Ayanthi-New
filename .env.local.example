# =============================================================================
# Hub Lanka Pvt Limited — LOCAL SHARING environment overrides (optional)
# =============================================================================
# docker-compose.local.yml already has a working default for every one of
# these baked in — you do NOT need this file to run the stack. It exists
# only so you can override a value (e.g. a port that collides with something
# else already running on your machine) without editing the compose file.
#
# To use it: copy to `.env` in the repo root (Docker Compose auto-loads
# `.env` regardless of which compose file you pass via -f), then edit.
#
#   cp .env.local.example .env
#
# NEVER put real secrets in here. Every value below is a shared, publicly
# known local-only placeholder — the same convention already used by
# docker-compose.yml/.env.example — safe to leave exactly as-is. This file is
# unrelated to `.env.production`/`.env.production.example`, which hold real
# production configuration and must never be copied here.
# =============================================================================

# --- Host ports (change if one of these is already in use on your machine) ---
API_PORT=3000
WEB_PORT=8080
# POSTGRES_PORT=5432   # only relevant if you uncomment postgres's `ports:`
#                        block in docker-compose.local.yml for direct DB-GUI access
# REDIS_PORT=6379      # only relevant if you uncomment redis's `ports:` block

# --- Database (must stay consistent with each other if you change any) -------
POSTGRES_USER=hublanka
POSTGRES_PASSWORD=hublanka_dev_password
POSTGRES_DB=hublanka
DATABASE_URL=postgresql://hublanka:hublanka_dev_password@postgres:5432/hublanka?schema=public
APP_DATABASE_URL=postgresql://hublanka_app:hublanka_app_dev_password@postgres:5432/hublanka?schema=public

# --- Auth (any 32+ character string works — this never protects real data) ---
JWT_ACCESS_SECRET=local-sharing-access-secret-not-for-real-use-32c
JWT_REFRESH_SECRET=local-sharing-refresh-secret-not-for-real-use-32c

# --- Web/API origins — must match WEB_PORT/API_PORT above if you change them -
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Misc -----------------------------------------------------------------
SWAGGER_ENABLED=true
LOG_PRETTY=true
