# =============================================================================
# Hub Lanka Pvt Limited — PRODUCTION environment template
# =============================================================================
# This is a template for `docker-compose.prod.yml`'s `env_file`, not a real
# environment file. Copy it to `.env.production`, then replace every
# CHANGE_ME with a real value from your platform's secret manager — never
# commit `.env.production` itself (it matches the root .gitignore's `.env*`
# rule already covering `.env`).
#
# Placeholders only: no cloud provider, region, or account has been chosen
# yet for this deployment. Where DEVELOPMENT_PLAN.md's Phase 11 names a
# specific target (Singapore region hosting, an off-site backup
# destination, a Sentry project), this file marks the exact line that
# decision plugs into rather than guessing a provider on your behalf.
# =============================================================================

# --- General -------------------------------------------------------------
NODE_ENV=production

# --- API -------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0

# The real public web origin(s) this API accepts requests from — a comma
# separated list, no trailing slash, e.g. https://ffms.hublanka.lk
CORS_ORIGINS=CHANGE_ME

# ARCHITECTURE §7: disabled (or put behind its own auth) in production.
SWAGGER_ENABLED=false

# --- Database (PostgreSQL 17 / Prisma 7) ------------------------------------
# Only consumed by docker-compose.prod.yml's self-hosted `postgres`
# service bootstrap. If Phase 11 replaces it with a managed instance,
# these three go away — DATABASE_URL/APP_DATABASE_URL below become the
# only database configuration, pointed at that managed instance instead.
POSTGRES_USER=hublanka
POSTGRES_PASSWORD=postgresql123
POSTGRES_DB=hublanka

# DATABASE_URL: privileged/migration connection — `prisma migrate deploy`
# (the release/entrypoint step) only. Never used by the running api/worker.
# Must use the same credentials/db name as POSTGRES_* above when targeting
# the self-hosted `postgres` service (host "postgres", the compose service
# name, not "localhost").
DATABASE_URL=CHANGE_ME
# APP_DATABASE_URL: restricted runtime connection the api/worker actually
# use — this role must have no UPDATE/DELETE grant on audit_log at the
# database level (ARCHITECTURE §10, apps/api/prisma/migrations/*_restrict_audit_log_grants).
APP_DATABASE_URL=CHANGE_ME

# --- Web (build-time only — see apps/web/Dockerfile) ------------------------
# Not read here: VITE_API_BASE_URL is baked into the web image at build
# time via `docker build --build-arg VITE_API_BASE_URL=...`, not read from
# this file at container start. Keep the two in sync by hand.

# --- Auth --------------------------------------------------------------------
# Generate real high-entropy secrets — e.g. `openssl rand -base64 48` — and
# store them in your secret manager. Never reuse the values from
# .env.example (those are local-dev-only placeholders).
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=hub_lanka_refresh_token

# Argon2id parameters (ARCHITECTURE §8) — do not lower memory cost without
# a documented reason (DEVELOPMENT_RULES §10).
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# --- Logging (Pino) ------------------------------------------------------------
LOG_LEVEL=info
# Structured JSON in production — a monitoring/log-aggregation pipeline
# (Phase 11's "monitoring, Sentry, uptime, job_run visibility") is what
# actually consumes this; pretty-printing is a local-dev convenience only.
LOG_PRETTY=false

# --- File storage (ARCHITECTURE §12) ----------------------------------------
# The local-disk adapter (STORAGE_LOCAL_DIR) is a development convenience
# — it does not survive a container being recreated/rescheduled. Phase 11's
# real target replaces this with an object-storage adapter (see
# apps/api/src/storage/storage.service.ts's own doc comment: an R2/S3-
# compatible adapter behind the same StorageService interface is a
# provider swap, not a rewrite) once a bucket/credentials exist. Until that
# adapter exists, STORAGE_LOCAL_DIR must point at a persistent volume, not
# ephemeral container storage.
STORAGE_LOCAL_DIR=/data/storage
AVATAR_MAX_SIZE_MB=3
RECEIPT_MAX_SIZE_MB=10

# --- Background worker (ARCHITECTURE §15) -----------------------------------
REDIS_URL=CHANGE_ME
PRINTER_ADAPTER=pdf
PDF_RENDER_CONCURRENCY=2
PDF_RENDER_TIMEOUT_MS=30000

# --- Business configuration (unchanged from .env.example — not a deployment concern) ---
CUTOFF_APPROACHING_HOURS=5
CUTOFF_URGENT_HOURS=1
ANALYTICS_FALLBACK_EXCHANGE_RATE=340.5
VITE_API_BASE_URL=http://localhost:3000/api/v1
